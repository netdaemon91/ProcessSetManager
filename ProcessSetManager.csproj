<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>ProcessSetManager</AssemblyName>
    <RootNamespace>ProcessSetManager</RootNamespace>
    <Product>ProcessSet Manager</Product>
    <Company>NetDaemon</Company>
    <Authors>NetDaemon</Authors>
    <Description>Windows process profile and session manager.</Description>
    <Version>0.6.0</Version>
    <FileVersion>0.6.0.0</FileVersion>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <ApplicationIcon>Assets\ProcessSetManager.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
